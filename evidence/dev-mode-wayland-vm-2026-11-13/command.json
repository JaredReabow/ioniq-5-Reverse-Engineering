[
  "<HOST_QEMU>",
  "-machine",
  "q35",
  "-accel",
  "tcg",
  "-cpu",
  "max,vendor=GenuineIntel",
  "-m",
  "2048",
  "-smp",
  "2",
  "-nic",
  "none",
  "-vga",
  "none",
  "-device",
  "VGA,id=display0,addr=01.0",
  "-kernel",
  "<PROJECT>/work/vm/kbuild/ws-dev-mode-wayland/bzImage",
  "-device",
  "loader,file=<PROJECT>/work/vm/kbuild/ws-dev-mode-wayland/manifest.bin,addr=0x20000000",
  "-device",
  "loader,file=<PROJECT>/work/vm/kbuild/ws-dev-mode-wayland/seed_dev.bin,addr=0x21000000",
  "-device",
  "loader,file=<PROJECT>/work/vm/kbuild/ws-dev-mode-wayland/seed_user.bin,addr=0x21000040",
  "-device",
  "sdhci-pci,id=sdhci0",
  "-drive",
  "if=none,id=sd0,format=raw,file=<PROJECT>/work/vm/kbuild/ws-dev-mode-wayland/rootfs.img,snapshot=on",
  "-device",
  "sd-card,drive=sd0",
  "-append",
  "root=/dev/mmcblk0p5 rootwait rootdelay=2 rootfstype=ext4 rw init=/init-dev-wayland.sh console=ttyS0,115200 panic=-1 loglevel=7 ABL.oemkm=40@20000000 ABL.seed=21000000,21000040",
  "-display",
  "none",
  "-serial",
  "stdio",
  "-monitor",
  "none",
  "-no-reboot",
  "-chardev",
  "file,id=devprobe,path=dev-wayland-trace.txt",
  "-device",
  "isa-serial,chardev=devprobe,index=3"
]
